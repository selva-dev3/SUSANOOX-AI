$background: #111110;
$surface: #171715;
$surface-raised: #1d1c1a;
$border: #57534e;
$text: #e8e4de;
$muted: #918c84;
$accent: #df7652;
$accent-soft: #a9573e;
$danger: #ef6a6a;

Screen {
    background: $background;
    color: $text;
}

#app-header {
    dock: top;
    width: 100%;
    height: 2;
    padding: 0 2;
    background: $background;
    border-bottom: solid #302e2a;
    content-align: left middle;
}

#brand {
    width: auto;
}

#connection-status {
    width: 1fr;
    text-align: center;
    color: $muted;
}

#project-path {
    width: 35%;
    text-align: right;
    color: $muted;
    text-overflow: ellipsis;
}

#conversation-shell {
    width: 100%;
    height: 1fr;
    padding: 1 2 0 2;
}

#conversation-view {
    width: 100%;
    height: 1fr;
    align-horizontal: center;
    scrollbar-color: $border;
    scrollbar-color-hover: $accent;
}

.message {
    width: 100%;
    height: auto;
    margin: 0 0 1 0;
    padding: 0 2;
    background: transparent;
    border-left: none;
}

.message.user {
    padding: 1 2;
    background: $surface-raised;
}

.message.error {
    color: $danger;
    border-left: tall $danger;
}

.message-label {
    width: 100%;
    height: 1;
    margin-bottom: 0;
    color: $accent;
    text-style: bold;
}

.message.error .message-label {
    color: $danger;
}

.message-content {
    width: 100%;
    height: auto;
    background: transparent;
}

#welcome-panel {
    width: 94%;
    max-width: 136;
    height: auto;
    margin: 1 0;
    padding: 0 2 1 2;
    background: $background;
    border: round $accent-soft;
}

#welcome-title {
    width: auto;
    height: 1;
    margin: 0 0 1 1;
    text-style: bold;
    color: $accent;
}

#welcome-greeting {
    width: 100%;
    text-align: center;
    text-style: bold;
}

#welcome-mark {
    width: 100%;
    height: 4;
    margin: 1 0;
    text-align: center;
    color: $accent;
    text-style: bold;
}

#welcome-context {
    width: 100%;
    height: 1;
    text-align: center;
    text-overflow: ellipsis;
    color: $muted;
}

#welcome-columns {
    width: 100%;
    height: auto;
}

.welcome-column {
    width: 1fr;
    height: auto;
    padding: 0 2;
}

.welcome-identity {
    padding-top: 1;
    border-right: solid $border;
}

.welcome-section-title {
    width: 100%;
    height: 1;
    color: $accent;
    text-style: bold;
}

.starter-action {
    width: 100%;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0;
    content-align: left middle;
    background: transparent;
    color: $text;
    border: none;
}

.starter-action:hover,
.starter-action:focus {
    background: $surface-raised;
    color: $accent;
}

#recent-activity {
    color: $muted;
}

.recent-title {
    margin-top: 1;
    border-top: solid #302e2a;
}

#welcome-hint {
    width: 100%;
    height: 2;
    margin-top: 1;
    padding: 1 1 0 1;
    color: $muted;
    border-top: solid #302e2a;
}

#activity-bar {
    width: 100%;
    height: 1;
    padding: 0 1;
    color: $muted;
}

#activity-spinner {
    display: none;
    width: 3;
    height: 1;
    color: $accent;
}

#activity-bar.busy #activity-spinner {
    display: block;
}

#activity-label {
    width: 1fr;
}

#prompt-composer {
    width: 100%;
    height: 3;
    background: transparent;
    border-top: solid $border;
    border-bottom: solid $border;
}

#prompt-composer:focus-within {
    border-top: solid $accent;
    border-bottom: solid $accent;
}

#prompt-mark {
    width: 3;
    height: 100%;
    padding: 1 0 0 0;
    color: $accent;
    text-style: bold;
}

#prompt-input {
    width: 1fr;
    height: 100%;
    padding: 0;
    border: none;
    background: transparent;
}

#send-button {
    width: 9;
    min-width: 9;
    height: 1;
    min-height: 1;
    margin: 0;
    padding: 0;
    background: transparent;
    color: $muted;
    border: none;
    border-left: solid #302e2a;
}

#send-button:hover,
#send-button:focus {
    background: $surface-raised;
    color: $accent;
    text-style: bold;
}

#shortcut-bar {
    width: 100%;
    height: 1;
    padding-left: 1;
    text-align: left;
    color: $muted;
}

#onboarding-card {
    width: 64;
    height: auto;
    margin-top: 5;
    padding: 3 5;
    background: $surface;
    border: round $border;
}

#onboarding-brand {
    width: 100%;
    text-align: center;
    text-style: bold;
    color: $accent;
}

#onboarding-tagline {
    width: 100%;
    margin-bottom: 3;
    text-align: center;
    color: $muted;
}

#key-instructions {
    margin-bottom: 1;
}

#api-key-input {
    margin-bottom: 1;
    border: tall $border;
}

#api-key-input:focus {
    border: tall $accent;
}

#verify-button {
    width: 100%;
    margin-top: 1;
    background: $accent;
    color: $background;
}

#verify-spinner {
    width: 100%;
    height: 2;
    color: $accent;
}

#verification-status {
    width: 100%;
    min-height: 2;
    text-align: center;
    color: #73e6a1;
}

#verification-status.error {
    color: $danger;
}

#credential-note {
    width: 100%;
    margin-top: 2;
    text-align: center;
    color: $muted;
}

Screen.-compact #project-path {
    display: none;
}

Screen.-compact #connection-status {
    text-align: right;
}

Screen.-compact #conversation-shell {
    padding: 1;
}

Screen.-compact #welcome-panel {
    width: 100%;
    padding: 0 1 1 1;
}

Screen.-compact #welcome-columns {
    layout: vertical;
}

Screen.-compact .welcome-column {
    width: 100%;
}

Screen.-compact .welcome-identity {
    border-right: none;
    border-top: solid $border;
}

Screen.-compact #shortcut-bar {
    display: none;
}

Screen.-compact #onboarding-card {
    width: 92%;
    padding: 2;
}

Screen.-short #conversation-shell {
    padding: 0 1;
}

Screen.-short #welcome-panel {
    margin: 0;
    padding: 0 1 1 1;
}

Screen.-short #shortcut-bar {
    display: none;
}
